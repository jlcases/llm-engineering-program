# Copia este fichero a la raíz del repo como .env y rellena lo que necesites.
# NUNCA subas el .env real al repo.

# --- Módulo 1+ ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Módulo 1+ (Amazon Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_PROFILE=
BEDROCK_MODEL_ID=

# Modelos directos (catálogo verificado en agosto de 2026; fija snapshots en producción)
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-haiku-4-5
RAGAS_JUDGE_MODEL=gpt-5.6-luna

# --- Módulo 3 (reranking) ---
COHERE_API_KEY=

# --- Módulos 4-6 (observabilidad) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
